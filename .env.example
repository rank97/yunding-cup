# ==========================================
# 环境变量配置示例 (.env.example)
# ==========================================

# 1. 数据库类型: sqlite 或 mysql
SPRING_PROFILES_ACTIVE=sqlite

# 2. 若使用 MySQL 模式时的连接配置:
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=yunding_cup
MYSQL_USER=root
MYSQL_PASSWORD=root

# 3. 前端服务端口与后端 API 地址
VITE_API_BASE_URL=http://localhost:8080/api/v1
